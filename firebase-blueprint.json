{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A digital asset project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "LIVE"] },
        "publishedVersionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "name", "slug", "status", "createdAt", "updatedAt"]
    },
    "LandingPage": {
      "title": "Landing Page Content",
      "description": "The structural content of a landing page.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "content": { "type": "object" }
      },
      "required": ["id", "name", "content"]
    },
    "PublishedVersion": {
      "title": "Published Version",
      "description": "An immutable version of a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "content": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "content", "createdAt"]
    },
    "DomainConnection": {
      "title": "Domain Connection",
      "description": "Mapping between hostname and project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "hostname": { "type": "string" },
        "type": { "type": "string", "enum": ["EDC_SUBDOMAIN", "CUSTOM_DOMAIN"] },
        "status": { "type": "string", "enum": ["PENDING", "ACTIVE"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "workspaceId", "hostname", "type", "status", "createdAt"]
    }
  },
  "firestore": {
    "projects": {
      "schema": "Project",
      "description": "Stores project metadata."
    },
    "projects/{projectId}/versions": {
      "schema": "PublishedVersion",
      "description": "Stores published versions of projects."
    },
    "domains": {
      "schema": "DomainConnection",
      "description": "Stores domain connections."
    },
    "landingPages": {
      "schema": "LandingPage",
      "description": "Stores landing page content drafts."
    }
  }
}
