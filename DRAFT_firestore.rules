rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // DomainConnections are readable by everyone to resolve routes, but only writable by system/admin
    match /domains/{domainId} {
      allow read: if true;
      allow write: if false; // Managed by backend
    }

    // Projects readable by workspace members
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Implement RBAC in next iteration
    }
  }
}
