rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Phase 3: Primitives & Global Safety Net
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // RBAC Primitives
    function getMember(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    function isMember(orgId) {
      return isSignedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgRole(orgId, role) {
      return isMember(orgId) && getMember(orgId).role == role;
    }

    function isOrgAdmin(orgId) {
      return isOrgRole(orgId, 'owner') || isOrgRole(orgId, 'admin');
    }

    // -------------------------------------------------------------------------
    // Pillar 2: Validation Blueprints
    // -------------------------------------------------------------------------

    function isValidOrganization(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'ownerId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().size() == 7
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.slug is string && data.slug.size() > 0 && data.slug.matches('^[a-z0-9-]+$')
        && data.ownerId == request.auth.uid
        && data.status in ['active', 'suspended', 'archived']
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['id', 'organizationId', 'userId', 'role', 'createdAt', 'status'])
        && data.keys().size() == 6
        && data.id == data.userId
        && data.userId == request.auth.uid
        && data.role in ['owner', 'admin', 'member']
        && data.createdAt == request.time
        && data.status == 'active';
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'organizationId', 'name', 'slug', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.organizationId is string && isValidId(data.organizationId)
        && data.name is string && data.name.size() > 0
        && data.status in ['draft', 'published', 'archived']
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'primaryOrganizationId', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.primaryOrganizationId is string;
    }

    // -------------------------------------------------------------------------
    // match blocks
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow create, update: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
    }

    match /organizations/{orgId} {
      allow get: if isMember(orgId);
      allow create: if isSignedIn() && isValidOrganization(incoming()) && incoming().id == orgId;
      allow update: if isOrgAdmin(orgId) && isValidOrganization(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'status', 'updatedAt']);

      match /members/{memberId} {
        allow get: if isMember(orgId);
        allow list: if isMember(orgId);
        allow create: if isSignedIn() && isValidMember(incoming()) && memberId == request.auth.uid;
        // Membership role changes restricted to admins
        allow update: if isOrgAdmin(orgId) && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status']);
      }

      match /projects/{projectId} {
        allow get: if isMember(orgId);
        allow list: if isMember(orgId);
        allow create: if isMember(orgId) && isValidProject(incoming()) && incoming().id == projectId && incoming().organizationId == orgId;
        allow update: if isMember(orgId) && (
          // Action: Rename/Settings
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'updatedAt']) ||
          // Action: Publish/Status
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'publishedVersionId', 'publishedAt', 'updatedAt'])
        );

        match /drafts/{draftId} {
          allow get: if isMember(orgId);
          allow write: if isMember(orgId) && incoming().projectId == projectId && incoming().organizationId == orgId;
        }

        match /versions/{versionId} {
          allow get: if isMember(orgId);
          allow list: if isMember(orgId);
          allow create: if isMember(orgId) && incoming().projectId == projectId && incoming().organizationId == orgId;
          allow update, delete: if false; // Immutable
        }

        match /domains/{domainId} {
          allow read: if isMember(orgId);
          allow create: if isOrgAdmin(orgId) && incoming().projectId == projectId && incoming().organizationId == orgId;
          allow update: if isOrgAdmin(orgId) && incoming().projectId == projectId;
          allow delete: if isOrgAdmin(orgId);
        }
      }
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn() && incoming().actorId == request.auth.uid;
      allow read: if isSignedIn() && isMember(incoming().organizationId);
    }
  }
}
